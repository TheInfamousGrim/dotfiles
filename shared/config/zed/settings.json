// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "autosave": "on_focus_change",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "edit_file": {
          "default": "allow"
        },
        "search_web": {
          "default": "allow"
        },
        "restore_file_from_disk": {
          "default": "allow"
        },
        "fetch": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            { "pattern": "^grep\\b" },
            { "pattern": "^sed\\b" },
            { "pattern": "^wc\\b" },
            { "pattern": "^cat\\b" },
            { "pattern": "^hexdump\\b" },
            { "pattern": "^head\\b" },
            { "pattern": "^ls\\b" },
            { "pattern": "^echo\\b" },
            { "pattern": "^awk\\b" },
            { "pattern": "^xxd\\b" },
            { "pattern": "^python3\\b" },
            { "pattern": "^git\\b" },
            { "pattern": "^pnpm\\s+run(\\s|$)" }
          ]
        },
        "save_file": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "effort": "medium",
      "provider": "zed.dev",
      "model": "gpt-5.5",
      "enable_thinking": true
    },
    "favorite_models": [
      {
        "provider": "deepseek",
        "model": "deepseek-chat",
        "enable_thinking": false
      },
      {
        "provider": "deepseek",
        "model": "deepseek-reasoner",
        "enable_thinking": false
      },
      {
        "provider": "deepseek",
        "model": "deepseek-v4-flash",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "deepseek",
        "model": "deepseek-v4-pro",
        "enable_thinking": true,
        "effort": "high"
      }
    ],
    "model_parameters": []
  },
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "session": {
    "trust_all_worktrees": true
  },
  "base_keymap": "Cursor",
  "vim_mode": true,
  "icon_theme": "Material Icon Theme",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Vaporwave Sunset"
  }
}
